# OpenCyber Harness host udev rules.
#
# Install on the HOST, not inside the container:
#   sudo install -m 0644 packaging/99-opencyber-hw.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# These rules make common red-team hardware readable by the user that runs
# docker. They do not grant capabilities; the container still needs explicit
# --device or --device /dev/bus/usb flags.

# --- SDR -------------------------------------------------------------------
# HackRF (Great Scott Gadgets)
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6089", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="604b", MODE="0660", TAG+="uaccess"
# RTL-SDR (Realtek)
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2838", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2832", MODE="0660", TAG+="uaccess"
# bladeRF / LimeSDR / Ettus
SUBSYSTEM=="usb", ATTR{idVendor}=="2cf0", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1d19", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="2500", MODE="0660", TAG+="uaccess"

# --- Bluetooth / BLE -------------------------------------------------------
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6002", MODE="0660", TAG+="uaccess"

# --- NFC / RFID ------------------------------------------------------------
# Proxmark3, ACS ACR122U, SCM SCL3711
SUBSYSTEM=="usb", ATTR{idVendor}=="9ac4", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="072f", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="04e6", MODE="0660", TAG+="uaccess"

# --- JTAG / SWD / debug probes --------------------------------------------
# SEGGER J-Link, CMSIS-DAP, ST-Link, NXP LPC-Link2, FTDI FT2232
SUBSYSTEM=="usb", ATTR{idVendor}=="1366", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0d28", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="1fc9", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0403", ATTR{idProduct}=="6014", MODE="0660", TAG+="uaccess"

# --- Logic analyzers -------------------------------------------------------
# Saleae, DSLogic, Cypress FX2
SUBSYSTEM=="usb", ATTR{idVendor}=="0925", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="21a9", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="04b4", ATTR{idProduct}=="8613", MODE="0660", TAG+="uaccess"

# --- Serial / UART adapters ------------------------------------------------
# CP210x, CH340, FTDI, STM32 CDC, Arduino, Raspberry Pi Pico, Adafruit
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="239a", MODE="0660", TAG+="uaccess"

# --- GPS / GNSS ------------------------------------------------------------
SUBSYSTEM=="usb", ATTR{idVendor}=="1546", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", MODE="0660", TAG+="uaccess"

# --- IR --------------------------------------------------------------------
SUBSYSTEM=="lirc", MODE="0660", TAG+="uaccess"
