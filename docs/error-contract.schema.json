{
  "$comment": "Generated by scripts/generate-error-docs.py. Do not edit by hand.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mitkox/opencyber/schemas/error-contract.schema.json",
  "title": "OpenCyber tool error",
  "description": "A refusal returned in a tool result. Codes are a closed set; category, retryable, and remediation are always present so a client never parses prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "category",
    "message",
    "retryable",
    "remediation"
  ],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "already_exists",
        "approval_invalid",
        "authorization_invalid",
        "authorization_required",
        "cancelled",
        "capability_unavailable",
        "child_failed",
        "conflict",
        "connection_failed",
        "engagement_not_found",
        "engagement_required",
        "execution_failed",
        "integration_unavailable",
        "integrity_mismatch",
        "internal_error",
        "invalid_argument",
        "limit_exceeded",
        "missing_parameter",
        "not_found",
        "offline_blocked",
        "permission_denied",
        "resource_constraint",
        "scope_denied",
        "timed_out",
        "truncated",
        "unknown_tool"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "cancelled",
        "conflict",
        "denied",
        "execution_failure",
        "integrity_mismatch",
        "internal",
        "invalid_input",
        "not_found",
        "resource_constraint",
        "timeout",
        "truncated",
        "unavailable"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limit": {
      "type": [
        "object",
        "null"
      ]
    },
    "details": {
      "type": "object"
    }
  }
}
